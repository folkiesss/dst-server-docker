# ====================================================
# Don't Starve Together Server Configuration (.env)
# ====================================================

# 1. Authentication (Required)
# Generate token at: https://accounts.klei.com/account/game/servers?game=DST
DST_CLUSTER_TOKEN=

# 2. General Server Info
DST_CLUSTER_NAME="My Docker DST Server"
DST_CLUSTER_DESCRIPTION="Hosted with Docker"
DST_CLUSTER_PASSWORD=
DST_CLUSTER_INTENTION=cooperative   # Options: cooperative | social | competitive | madness

# 3. Gameplay Settings
DST_GAME_MODE=survival              # Options: survival | endless | wilderness
DST_MAX_PLAYERS=16
DST_PVP=false                       # Options: true | false
DST_PAUSE_WHEN_EMPTY=true           # Options: true | false

# 4. Console & Security
DST_ENABLE_CONSOLE=true             # Options: true | false
DST_CLUSTER_KEY=secret_dst_cluster_key_change_me

# 5. Network Ports (Host UDP)
MASTER_PORT=10999
CAVES_PORT=11000

# 6. Workshop Mods (Optional pre-download list by ID)
# Example: WORKSHOP_MODS="378160970 375850593"
WORKSHOP_MODS=
